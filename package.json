{
  "name": "tiff-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json",
    "build": "npm run data:check && npm run typecheck && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "build:core": "tsc",
    "data:import": "node --experimental-strip-types scripts/import-tiff.ts",
    "data:check": "node --experimental-strip-types scripts/import-tiff.ts --check",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "ical.js": "^2.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
